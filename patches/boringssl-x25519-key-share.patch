+int SSL_get_x25519_key_share_private_key(const SSL *ssl, uint8_t out[32]) {
+  if (ssl == nullptr || out == nullptr) {
+    return 0;
+  }
+
+  const auto *ssl_impl = FromOpaque(ssl);
+  Span<const uint8_t> private_key;
+  if (ssl_impl->config != nullptr) {
+    private_key = ssl_impl->config->x25519_key_share_private_key;
+  } else {
+    private_key = ssl_impl->x25519_key_share_private_key;
+  }
+  if (private_key.size() != 32) {
+    return 0;
+  }
+
+  OPENSSL_memcpy(out, private_key.data(), private_key.size());
+  return 1;
+}
