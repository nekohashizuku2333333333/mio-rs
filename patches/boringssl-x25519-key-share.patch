diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 7c498cd..c22702f 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -2419,6 +2419,12 @@ bool ssl_setup_key_shares(SSL_HANDSHAKE *hs, uint16_t override_group_id) {
   SSLImpl *const ssl = hs->ssl;
   hs->key_shares.clear();
   hs->key_share_bytes.Reset();
+  if (override_group_id == 0) {
+    // This is the initial ClientHello. Start with no cached X25519 private key
+    // and populate it below if the selection includes an X25519 share.
+    ssl->config->x25519_key_share_private_key.Reset();
+    ssl->x25519_key_share_private_key.Reset();
+  }
 
   // If offering a PAKE, do not set up key shares. We do not currently support
   // clients offering both PAKE and non-PAKE modes, including resumption.
@@ -2504,18 +2510,37 @@ bool ssl_setup_key_shares(SSL_HANDSHAKE *hs, uint16_t override_group_id) {
     }
   }
 
+  Array<uint8_t> x25519_private_key;
   CBB key_exchange;
   for (const uint16_t group_id : *selected_key_shares) {
     UniquePtr<SSLKeyShare> key_share = SSLKeyShare::Create(group_id);
     if (key_share == nullptr ||                                    //
         !CBB_add_u16(cbb.get(), group_id) ||                       //
         !CBB_add_u16_length_prefixed(cbb.get(), &key_exchange) ||  //
-        !key_share->Generate(&key_exchange) ||                     //
-        !hs->key_shares.TryPushBack(std::move(key_share))) {
+        !key_share->Generate(&key_exchange)) {
+      return false;
+    }
+
+    if (group_id == SSL_GROUP_X25519) {
+      ScopedCBB private_key_cbb;
+      if (!CBB_init(private_key_cbb.get(), 32) ||
+          !key_share->SerializePrivateKey(private_key_cbb.get()) ||
+          !CBBFinishArray(private_key_cbb.get(), &x25519_private_key) ||
+          x25519_private_key.size() != 32) {
+        return false;
+      }
+    }
+
+    if (!hs->key_shares.TryPushBack(std::move(key_share))) {
       return false;
     }
   }
 
+  if (override_group_id == 0) {
+    ssl->config->x25519_key_share_private_key =
+        std::move(x25519_private_key);
+  }
+
   return CBBFinishArray(cbb.get(), &hs->key_share_bytes);
 }
 
