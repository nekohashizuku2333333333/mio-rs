+// SSL_get_x25519_key_share_private_key copies the X25519 key share private key
+// generated for the initial ClientHello to `out`. It returns one and writes
+// exactly 32 bytes if the initial ClientHello contained an X25519 key share and
+// its private key was serialized. Otherwise, it returns zero. The key remains
+// available after HelloRetryRequest and handshake completion, including if
+// handshake configuration shedding is enabled.
+OPENSSL_EXPORT int SSL_get_x25519_key_share_private_key(const SSL *ssl,
+                                                       uint8_t out[32]);
